{
  "name": "Kocharian AI",
  "short_name": "Kocharian",
  "description": "A private, offline ChatGPT-style assistant powered by an on-board Qwen GGUF model. Chat, images and audio stay on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#212121",
  "theme_color": "#10a37f",
  "categories": ["productivity", "utilities", "education"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "short_name": "New", "url": "/?new=1", "description": "Start a fresh conversation" },
    { "name": "Models", "short_name": "Models", "url": "/?panel=models", "description": "Manage on-board models" }
  ]
}
